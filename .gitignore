# environments
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# large artifacts
models/*
!models/.gitkeep
data/vizwiz/
data/raw/
data/custom/images/
# 2.4 GB / 4002 images, redownloaded from Kaggle on demand (CC0-1.0). Staging this is
# what makes `git add .` appear to hang.
data/currency/
data/currency_raw/
test-images/
*.gguf
*.zip
*.pt
*.safetensors
*.onnx
# Screen recordings and exported write-ups live in this directory during a demo push. The
# 08-21 recording alone is 267 MB, and a stray `git add .` would put it in history for good
# -- git keeps deleted blobs, so this is not a mistake you can tidy up afterwards.
*.mp4
*.mov
*.pdf

# results & logs
eval/results/*
*.log
wandb/

# ...but evaluation CSVs are the project's evidence trail, not build artifacts. They are
# small (~60 KB), and every claim in the report traces back to one. Keep them versioned so
# a result can be reproduced and compared against later runs.
!eval/results/*.csv

# OS/editor
.DS_Store
Thumbs.db

# runtime scratch (captures are deleted after answering, audio is regenerated)
runtime/
# backstop: the CLI used to default MMSTTSEngine to the working directory, which
# dropped drishti_mr.wav into the repo root. Fixed, but generated speech is never
# worth versioning wherever it lands.
*.wav


*.zip
